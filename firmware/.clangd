Diagnostics:
	Suppress: [
		"-Wvla-cxx-extension",
		"member_function_call_bad_type",
		"unknown_typename",
		"redefinition_different_typedef",
		"pp_file_not_found",
		"init_conversion_failed",
		"typecheck_convert_incompatible_pointer",
		"field_incomplete_or_sizeless"
		]
	UnusedIncludes: None

